BT /F1 16 Tf 1 0 0 1 50 726 Tm (Dockerfile) Tj ET
BT /F2 9 Tf 1 0 0 1 50 702 Tm (FROM node:20-alpine AS builder) Tj ET
BT /F2 9 Tf 1 0 0 1 50 691 Tm () Tj ET
BT /F2 9 Tf 1 0 0 1 50 680 Tm (WORKDIR /app/frontend) Tj ET
BT /F2 9 Tf 1 0 0 1 50 669 Tm () Tj ET
BT /F2 9 Tf 1 0 0 1 50 658 Tm (# Build-time arguments coming from Jenkins) Tj ET
BT /F2 9 Tf 1 0 0 1 50 647 Tm (ARG APP_VERSION="v1.0.0") Tj ET
BT /F2 9 Tf 1 0 0 1 50 636 Tm (ARG BUILD_NUMBER="0") Tj ET
BT /F2 9 Tf 1 0 0 1 50 625 Tm (ARG DEPLOY_TIME="unknown") Tj ET
BT /F2 9 Tf 1 0 0 1 50 614 Tm (ARG ENVIRONMENT="Kubernetes") Tj ET
BT /F2 9 Tf 1 0 0 1 50 603 Tm () Tj ET
BT /F2 9 Tf 1 0 0 1 50 592 Tm (# Step 1: Copy only package files first \(better layer caching\)) Tj ET
BT /F2 9 Tf 1 0 0 1 50 581 Tm (COPY frontend/package.json frontend/package-lock.json* ./) Tj ET
BT /F2 9 Tf 1 0 0 1 50 570 Tm () Tj ET
BT /F2 9 Tf 1 0 0 1 50 559 Tm (# Step 2: Install ALL dependencies \(vite lives in devDependencies\)) Tj ET
BT /F2 9 Tf 1 0 0 1 50 548 Tm (RUN npm install) Tj ET
BT /F2 9 Tf 1 0 0 1 50 537 Tm () Tj ET
BT /F2 9 Tf 1 0 0 1 50 526 Tm (# Step 3: Copy source AFTER install \(node_modules will NOT be overwritten\)) Tj ET
BT /F2 9 Tf 1 0 0 1 50 515 Tm (COPY frontend/ ./) Tj ET
BT /F2 9 Tf 1 0 0 1 50 504 Tm () Tj ET
BT /F2 9 Tf 1 0 0 1 50 493 Tm (# Step 4: Create build-info.json that the React app will fetch at runtime) Tj ET
BT /F2 9 Tf 1 0 0 1 50 482 Tm (RUN mkdir -p public && \\) Tj ET
BT /F2 9 Tf 1 0 0 1 50 471 Tm (    printf '{\\n  "appVersion": "%s",\\n  "buildNumber": "%s",\\n  "deployTime": "%s",\\n ) Tj ET
BT /F2 9 Tf 1 0 0 1 50 460 Tm (    "environment": "%s"\\n}\\n' \\) Tj ET
BT /F2 9 Tf 1 0 0 1 50 449 Tm (    "$APP_VERSION" "$BUILD_NUMBER" "$DEPLOY_TIME" "$ENVIRONMENT" > public/build-info.json) Tj ET
BT /F2 9 Tf 1 0 0 1 50 438 Tm () Tj ET
BT /F2 9 Tf 1 0 0 1 50 427 Tm (# Step 5: Build production bundle) Tj ET
BT /F2 9 Tf 1 0 0 1 50 416 Tm (RUN npm run build) Tj ET
BT /F2 9 Tf 1 0 0 1 50 405 Tm () Tj ET
BT /F2 9 Tf 1 0 0 1 50 394 Tm (# --- Runtime image ---) Tj ET
BT /F2 9 Tf 1 0 0 1 50 383 Tm (FROM nginx:stable-alpine) Tj ET
BT /F2 9 Tf 1 0 0 1 50 372 Tm () Tj ET
BT /F2 9 Tf 1 0 0 1 50 361 Tm (COPY --from=builder /app/frontend/dist /usr/share/nginx/html) Tj ET
BT /F2 9 Tf 1 0 0 1 50 350 Tm (COPY nginx.conf /etc/nginx/conf.d/default.conf) Tj ET
BT /F2 9 Tf 1 0 0 1 50 339 Tm () Tj ET
BT /F2 9 Tf 1 0 0 1 50 328 Tm (EXPOSE 80) Tj ET
BT /F2 9 Tf 1 0 0 1 50 317 Tm () Tj ET
BT /F2 9 Tf 1 0 0 1 50 306 Tm (CMD ["nginx", "-g", "daemon off;"]) Tj ET
endstream
endobj
